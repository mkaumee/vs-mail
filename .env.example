# Copy to .env for LOCAL runs only.
# In the deployed setup these live in Railway's environment variables
# and no .env exists locally at all.

# Required by DeepSeekProvider (runs inside the Railway service).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Shared secret guarding every API route except /health.
VS_SERVICE_TOKEN=

# Required by RemoteProvider (local runs and the frontend).
VS_SERVICE_URL=

# Which provider the pipeline uses: mock | deepseek | remote
VS_PROVIDER=mock

# -- Gmail ---------------------------------------------------------------
# Where Google sends the browser back after consent. It must match a redirect
# URI registered on the OAuth client exactly. Defaults to localhost:8000.
VS_OAUTH_REDIRECT=

# The OAuth client as JSON, for a deployment. The download is gitignored so
# it never reaches the image; paste the whole file's contents here instead.
VS_GMAIL_CREDENTIALS_JSON=

# The authorised token as JSON, for a deployment whose filesystem is wiped on
# every redeploy. Set it and token.json is never read or written. Get the
# value by connecting once and running: cat token.json
VS_GMAIL_TOKEN_JSON=

# Where test sends go. Set this and every reply the app sends is diverted
# here instead of to the address on the email, with a banner saying so.
# Without it the app refuses to send at all — the bundle's senders look like
# real freight desks, and a demo that emails one is worse than one that
# sends nothing.
VS_TEST_RECIPIENT=

# Where the OAuth client and the token live, if not the repository root.
VS_GMAIL_CREDENTIALS=credentials.json
VS_GMAIL_TOKEN=token.json

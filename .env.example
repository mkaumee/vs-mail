# Copy to .env for LOCAL runs only.
# In the deployed setup these live in Railway's environment variables
# and no .env exists locally at all.

# Required by DeepSeekProvider (runs inside the Railway service).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Shared secret guarding every API route except /health.
VS_SERVICE_TOKEN=

# Required by RemoteProvider (local runs and the frontend).
VS_SERVICE_URL=

# Which provider the pipeline uses: mock | deepseek | remote
VS_PROVIDER=mock
